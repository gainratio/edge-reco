# EdgeReco — optional build, dev, and test environment variables.
#
# All variables are optional: `pnpm -F frontend run build:pages` works out of the
# box on a fresh clone using the committed signed 100,000-product demo bundle.
# For local SPA dev overrides, copy `frontend/.env.example` to `frontend/.env`.

# --- SPA static / Pages build (`frontend/app`) ---

# Public base path for static Pages builds (`/` for apex domains, `/<repo>/` for subpaths).
# VITE_BASE=/

# Signed catalog bundle origin or app-relative path (`bundle` for static Pages builds,
# `http://localhost:8081` when running the local Docker/Caddy demo stack).
# VITE_BUNDLE_BASE_URL=bundle

# Product image mode (`local` serves bundled SVG/WebP assets; `remote` allows listed hosts).
# EDGERECO_IMAGE_MODE=local
# VITE_REMOTE_IMAGE_HOSTS=

# --- Local dev & test runner overrides (not exposed to the browser) ---

# Local Playwright static catalog server port override (default: 8910 / 8920).
# CATALOG_PORT=8910

# Set to "1" to skip model-downloading embedder parity tests in offline environments.
# EDGE_RECO_SKIP_EMBEDDING_PARITY=
