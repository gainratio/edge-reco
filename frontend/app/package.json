{
	"name": "frontend",
	"private": true,
	"version": "0.13.0",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "node scripts/download-model.mjs && node scripts/stage-ort-wasm.mjs",
		"build": "tsc -b && vite build",
		"build:pages": "node scripts/build-pages.mjs",
		"lint": "biome check .",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:preflight": "node --test scripts/*.test.mjs",
		"test:artifacts": "PRODUCTION_ARTIFACT_DIR=dist node --test scripts/production-artifacts.test.mjs",
		"test:e2e": "playwright test",
		"test:e2e:c1": "node scripts/download-model.mjs && node scripts/stage-ort-wasm.mjs && playwright test -c playwright.c1.config.ts",
		"test:e2e:offline": "VITE_BUNDLE_BASE_URL=http://localhost:8921/catalog pnpm run build && playwright test -c playwright.offline.config.ts",
		"typecheck": "tsc -b",
		"gen-icons": "node scripts/gen-icons.mjs",
		"preview": "vite preview",
		"verify:i18n": "node scripts/verify-i18n.mjs",
		"measure:live": "node scripts/measure-live-boot.mjs"
	},
	"dependencies": {
		"@edgeproc/browser": "github:hseshadr/edgeproc-browser#02171df60afc8b09d6439112ea7ea3202338d46a",
		"@edgereco/browser": "workspace:*",
		"@edgeproc/errors": "^0.1.1",
		"@huggingface/transformers": "^4.2.0",
		"i18next": "^26.4.2",
		"motion": "^13.4.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-i18next": "^17.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@playwright/test": "^1.63.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.6.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitest/coverage-v8": "^5.0.1",
		"jsdom": "^30.1.0",
		"sharp": "^0.35.4",
		"typescript": "~7.0.2",
		"vite": "^8.3.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.1",
		"workbox-window": "7.4.1"
	}
}
